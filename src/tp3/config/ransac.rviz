Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Alpha: 0.5
      Cell Size: 1
      Plane: XY
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Puntos 3D sin RANSAC
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /points3d
      Style: Points
      Size (Pixels): 2
      Size (m): 0.01
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 180; 180; 180
      Alpha: 0.35
      Decay Time: 0
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Puntos 3D RANSAC
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /ransac_points3d
      Style: Points
      Size (Pixels): 4
      Size (m): 0.01
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 255; 255; 255
      Alpha: 1
      Decay Time: 0
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: cam0
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 8
      Focal Point:
        X: 0
        Y: 0
        Z: 2
      Name: Current View
      Pitch: 0.5
      Yaw: 0.7
Window Geometry:
  Height: 800
  Width: 1200
